# --- Frontend (exposé au navigateur : uniquement des valeurs publiques) ---
# URL et clé publique (anon / publishable) du projet Supabase.
# En local : valeurs affichées par `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Fonctions Netlify (serveur uniquement, jamais préfixées VITE_) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Fournisseurs IA : laisser vide pour désactiver. L'application reste utilisable sans IA.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Fournisseur par défaut : openai | anthropic
AI_DEFAULT_PROVIDER=anthropic
# Fournisseur de secours utilisé si le principal est indisponible. Vide = aucun basculement.
# Ne renseigner que si vous acceptez une facturation chez ce second fournisseur.
AI_FALLBACK_PROVIDER=

# Modèles (vérifier les noms disponibles sur votre compte)
OPENAI_CHAT_MODEL=
OPENAI_ANALYSIS_MODEL=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
ANTHROPIC_ANALYSIS_MODEL=claude-haiku-5-5
# Modèles multimodaux pour l'analyse des photos de matériel (par défaut : modèle conversationnel)
ANTHROPIC_VISION_MODEL=
OPENAI_VISION_MODEL=

# Limites de consommation par utilisateur et par jour (0 = illimité)
AI_DAILY_REQUEST_LIMIT=60
AI_DAILY_TOKEN_LIMIT=300000
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_MS=25000

# Script de démonstration (local) : npm run seed:demo
SUPABASE_SERVICE_ROLE_KEY=
DEMO_EMAIL=demo@workoutwith.local
DEMO_PASSWORD=
